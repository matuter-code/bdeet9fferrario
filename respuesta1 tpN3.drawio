        <!-- Cuadro de Nota Explicativa -->
        <mxCell id="note1" value="NOTAS DEL MODELO:&#xa;• Un Director puede dirigir muchas Películas (1 a N). Cada Película tiene 1 Director.&#xa;• Una Película tiene muchos Actores, y un Actor trabaja en muchas Películas (relación N:M).&#xa;• La relación N:M se resuelve con la tabla intermedia REPARTO, incorporando el atributo descriptivo 'personaje'." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9c4;strokeColor=#d7ccc8;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
