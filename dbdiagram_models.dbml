// ========================================================
// TRABAJO PRÁCTICO Nº 4: MODELADO FÍSICO (dbdiagram.io)
// ========================================================

// --------------------------------------------------------
// PROBLEMA 1: Clientes, Pedidos, Artículos y Fábricas
// --------------------------------------------------------

Table p1_cliente {
  id_cliente long [pk, increment]
  saldo bigfloat
  limite_credito bigfloat
  descuento float
}

Table p1_direcciones_cliente {
  id_dir long [pk, increment]
  cliente_id long [ref: > p1_cliente.id_cliente]
  calle varchar(255)
  numero varchar(20)
  comuna varchar(100)
  ciudad varchar(100)
}

Table p1_pedido {
  id_pedido long [pk, increment]
  cliente_id long [ref: > p1_cliente.id_cliente]
  fecha timestamp
  calle_envio varchar(255)
  nro_envio varchar(20)
  comuna_envio varchar(100)
  ciudad_envio varchar(100)
}

Table p1_articulo {
  id_articulo long [pk, increment]
  descripcion varchar(255)
}

Table p1_pedido_articulo {
  id long [pk, increment]
  pedido_id long [ref: > p1_pedido.id_pedido]
  articulo_id long [ref: > p1_articulo.id_articulo]
  cantidad integer
}

Table p1_fabrica {
  id_fabrica long [pk, increment]
  telefono varchar(50)
}

Table p1_articulo_fabrica {
  id long [pk, increment]
  articulo_id long [ref: > p1_articulo.id_articulo]
  fabrica_id long [ref: > p1_fabrica.id_fabrica]
  existencias integer
}

// --------------------------------------------------------
// PROBLEMA 2: Proveedores, Categorías, Productos, Ventas y Clientes
// --------------------------------------------------------

Table p2_categoria {
  id_categoria long [pk, increment]
  nombre varchar(100)
  descripcion varchar(255)
}

Table p2_proveedor {
  rut long [pk]
  nombre varchar(150)
  web varchar(255)
  telefono varchar(50)
  calle varchar(255)
  numero varchar(20)
  comuna varchar(100)
  ciudad varchar(100)
}

Table p2_producto {
  id_producto long [pk, increment]
  categoria_id long [ref: > p2_categoria.id_categoria]
  proveedor_rut long [ref: > p2_proveedor.rut]
  nombre varchar(150)
  precio bigfloat
  stock integer
}

Table p2_cliente {
  rut long [pk]
  nombre varchar(150)
  calle varchar(255)
  numero varchar(20)
  comuna varchar(100)
  ciudad varchar(100)
}

Table p2_telefono_cliente {
  id_tel long [pk, increment]
  cliente_rut long [ref: > p2_cliente.rut]
  telefono varchar(50)
}

Table p2_venta {
  id_venta long [pk, increment]
  cliente_rut long [ref: > p2_cliente.rut]
  fecha timestamp
  descuento float
}

Table p2_detalle_venta {
  id long [pk, increment]
  venta_id long [ref: > p2_venta.id_venta]
  producto_id long [ref: > p2_producto.id_producto]
  cantidad integer
}

// --------------------------------------------------------
// PROBLEMA 3: Sedes, Complejos, Eventos y Comisarios
// --------------------------------------------------------

Table p3_sede {
  id_sede long [pk, increment]
  presupuesto bigfloat
}

Table p3_complejo {
  id_complejo long [pk, increment]
  sede_id long [ref: > p3_sede.id_sede]
  localizacion varchar(255)
  jefe varchar(150)
}

Table p3_unideportivo {
  id_complejo long [pk, ref: - p3_complejo.id_complejo]
}

Table p3_polideportivo {
  id_complejo long [pk, ref: - p3_complejo.id_complejo]
}

Table p3_area {
  id_area long [pk, increment]
  polideportivo_id long [ref: > p3_polideportivo.id_complejo]
  localizacion varchar(255)
}

Table p3_evento {
  id_evento long [pk, increment]
  complejo_id long [ref: > p3_complejo.id_complejo]
  fecha timestamp
  duracion integer
  num_participantes integer
}

Table p3_equipamiento_evento {
  id_equip long [pk, increment]
  evento_id long [ref: > p3_evento.id_evento]
  descripcion varchar(255)
}

Table p3_comisario {
  id_comisario long [pk, increment]
  nombre varchar(150)
}

Table p3_evento_comisario {
  id long [pk, increment]
  evento_id long [ref: > p3_evento.id_evento]
  comisario_id long [ref: > p3_comisario.id_comisario]
}

Table p3_juez {
  id_comisario long [pk, ref: - p3_comisario.id_comisario]
}

Table p3_observador {
  id_comisario long [pk, ref: - p3_comisario.id_comisario]
}

// --------------------------------------------------------
// PROBLEMA 4: Libros, Autores, Ediciones, Copias y Usuarios
// --------------------------------------------------------

Table p4_autor {
  id_autor long [pk, increment]
  nombre varchar(150)
}

Table p4_libro {
  id_libro long [pk, increment]
  titulo varchar(255)
}

Table p4_autor_libro {
  id long [pk, increment]
  autor_id long [ref: > p4_autor.id_autor]
  libro_id long [ref: > p4_libro.id_libro]
}

Table p4_edicion {
  isbn long [pk]
  libro_id long [ref: > p4_libro.id_libro]
  año integer
  idioma varchar(50)
}

Table p4_copia {
  id_copia long [pk, increment]
  edicion_isbn long [ref: > p4_edicion.isbn]
  numero integer
}

Table p4_usuario {
  rut long [pk]
  nombre varchar(150)
}

Table p4_prestamo {
  id_prestamo long [pk, increment]
  copia_id long [ref: > p4_copia.id_copia]
  usuario_rut long [ref: > p4_usuario.rut]
  fecha_prestamo timestamp
  fecha_devolucion timestamp
}
